<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Genre Updater LaunchAgent Template

  This is a TEMPLATE. install.sh expands $HOME and deploys it to
  ~/Library/LaunchAgents/com.music.genreautoupdater.plist

  Paths follow the layout defined in launchctl/bin/common.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.music.genreautoupdater</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Wrapper script deployed by install.sh -->
        <string>$HOME/.local/share/genreupdater/bin/run-daemon.sh</string>
    </array>

    <!-- Trigger on Music Library changes -->
    <key>WatchPaths</key>
    <array>
        <string>$HOME/Music/Music/Music Library.musiclibrary</string>
    </array>

    <!-- Guaranteed hourly tick as fallback when WatchPaths events are coalesced or missed -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- launchd does not create parent directories: install.sh creates logs/ -->
    <key>StandardOutPath</key>
    <string>$HOME/.local/state/genreupdater/logs/launchctl-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/.local/state/genreupdater/logs/launchctl-stderr.log</string>

    <!-- Minimum 15 minutes between triggers; keep incremental_interval_minutes in my-config.yaml just below it -->
    <key>ThrottleInterval</key>
    <integer>900</integer>

    <!-- Don't run on login, only on WatchPaths trigger or the hourly tick -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Not a persistent daemon, exits after each run -->
    <key>KeepAlive</key>
    <false/>

    <!-- Low CPU priority -->
    <key>Nice</key>
    <integer>10</integer>

    <!-- Grace period between SIGTERM and SIGKILL when launchd stops the job; run-daemon.sh caps the runtime with timeout -->
    <key>ExitTimeOut</key>
    <integer>14400</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
